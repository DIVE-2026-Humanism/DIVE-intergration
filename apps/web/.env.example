EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_APP_ENV=development
# 카카오 개발자콘솔 > 앱 키 > REST API 키 (백엔드 KAKAO_CLIENT_ID와 동일해야 함)
EXPO_PUBLIC_KAKAO_REST_API_KEY=your-kakao-rest-api-key
# 카카오가 인가 코드를 전달할 백엔드 콜백 URL (카카오 콘솔에도 동일하게 등록)
# 콜백 서버는 code/state를 보존해 jabgonggu://auth 로 302 리다이렉트해야 한다.
EXPO_PUBLIC_KAKAO_REDIRECT_URI=http://192.168.0.68:8082/api/auth/kakao/callback
