# Local secrets and development environments
**/.env
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/*.py[cod]

# KCB rows must not be committed to the integration repository
data/kcb/*
!data/kcb/.keep
KCB/

# Local AI service outputs
LLM service/artifacts/*
!LLM service/artifacts/.gitkeep
LLM service/Dataset/KCB_공식데이터.csv
LLM service/Dataset/*KCB*원본*.csv
LLM service/Dataset/*개인정보*.csv
LLM service/Dataset/KCB_테스트_합성데이터.csv
LLM service/Dataset/KCB_테스트_합성데이터.manifest.json
LLM service/Dataset/KCB_테스트_샘플.json
